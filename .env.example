# The proxy is local-only unless you deliberately change HOST.
HOST=127.0.0.1
PORT=8050

# For a LAN test, use your actual LAN CIDR, for example:
# HOST=0.0.0.0
# ALLOWED_CLIENTS=127.0.0.1,::1,192.168.1.0/24
#
# For a VPS, replace 203.0.113.10 with the public IP used by your Portal's network.
ALLOWED_CLIENTS=127.0.0.1,::1

# Allow any public destination by default. Tighten this after observing the
# PlayStation hostnames needed by your own device.
ALLOWED_HOSTS=*
ALLOWED_CONNECT_PORTS=443
ALLOWED_HTTP_PORTS=80
BLOCK_PRIVATE_TARGETS=true

# This safety latch must remain false. Setting it to true together with
# ALLOWED_CLIENTS=* deliberately creates a public proxy.
ALLOW_PUBLIC_PROXY=false

MAX_CONNECTIONS=128
MAX_CONNECTIONS_PER_CLIENT=24
MAX_HEADER_BYTES=16384
HEADERS_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=30000
CONNECT_TIMEOUT_MS=10000
HTTP_IDLE_TIMEOUT_MS=60000
TUNNEL_IDLE_TIMEOUT_MS=300000
SHUTDOWN_GRACE_MS=10000
LOG_FORMAT=json

# Optional upstream HTTP proxy chaining.
UPSTREAM_HOST=
UPSTREAM_PORT=8050
